# ArcticAI remains at the TLS origin root. Mutinatulkki is isolated below its
# public path and is proxied to a localhost-only Docker port.
server {
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;

    server_name 193.167.145.67;

    ssl_certificate     /etc/nginx/ssl/arcticai.crt;
    ssl_certificate_key /etc/nginx/ssl/arcticai.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 4m;

    # Keep ArcticAI's existing root API untouched.
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        gzip off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /TKI-hankkeet/ArcticAIChatbotti {
        return 301 /TKI-hankkeet/ArcticAIChatbotti/;
    }

    location ^~ /TKI-hankkeet/ArcticAIChatbotti/ {
        client_max_body_size 100m;
        proxy_pass http://127.0.0.1:5500/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Preserve ArcticAI's existing root frontend.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        gzip on;
        gzip_proxied any;
        gzip_types application/javascript application/json application/wasm text/css text/plain;
        gzip_min_length 1024;
    }
}
